         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">installation, operating, AXIOM Series Installation &amp; Operating Guide</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Installation &amp; Operating Guide for the AXIOM Series coffee breewers.  This equipment will brew a 1/2 gallon batch of coffee into an awaiting server.  The brewer may have a hot water faucet for allied beverage use.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>AXIOM</rdf:li>
               <rdf:li>Installation Guide</rdf:li>
               <rdf:li>Operating Guide</rdf:li>
            </rdf:Bag>
         </dc:subject>
